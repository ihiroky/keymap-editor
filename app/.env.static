# 静的ホスティング用プロファイル。
# `npm run build:static`（env-cmd 経由）から読み込まれる。
#
# API サーバーを使わず、定義データ (zmk-data) をアプリと同じディレクトリに
# 同梱して HTTP GET で取得する。ソースは Browser File のみ。
# GitHub Pages 配信に合わせて /keymap-editor/ 配下で公開する。
PUBLIC_URL=/keymap-editor
REACT_APP_ENABLE_GITHUB=false
REACT_APP_ENABLE_LOCAL=false
REACT_APP_ENABLE_BROWSER_FILE=true
